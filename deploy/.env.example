# ---------------------------------------------------------------------------
# RevHive 私有化部署配置
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# ---------------------------------------------------------------------------

# 要审查的仓库在本机的绝对路径（只读挂载进容器）
REVIEW_PATH=/path/to/your/repo

# ---- 模型接入 ----
# 二选一：A) 接国产模型 API（代码只发往这一家）
#         B) 完全不联网，用下面的 ollama 服务（见 docker-compose.ollama.yml）

# A) 国产模型 API —— 以下任选其一，改 BASE_URL 和 MODEL 即可
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 常用组合（复制对应两行覆盖上面的值）：
#   DeepSeek   https://api.deepseek.com/v1                      deepseek-chat
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4              glm-4
#   Kimi       https://api.moonshot.cn/v1                        kimi
#   小米 MiMo  https://api.xiaomimimo.com/v1                     mimo-v2.5-pro

# B) 完全离线（配合 docker-compose.ollama.yml 使用）
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5-coder:14b
